{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "English Thinking Vocabulary Item",
  "type": "object",
  "required": ["id", "word", "grade", "level", "category", "subcategory", "core_direction", "related"],
  "properties": {
    "id": {"type": "integer"},
    "word": {"type": "string"},
    "grade": {"type": "string"},
    "level": {"type": "string"},
    "category": {"type": "string"},
    "subcategory": {"type": "string"},
    "core_direction": {"type": "string"},
    "related": {"type": "array", "items": {"type": "string"}},
    "learning_layers": {
      "type": "object",
      "properties": {
        "review_status": {"type": "string", "enum": ["draft", "reviewed"]},
        "quick": {
          "type": "object",
          "required": ["hook", "core_image", "one_line", "prototype"],
          "properties": {
            "hook": {"type": "string", "minLength": 1},
            "core_image": {"type": "string", "minLength": 1},
            "one_line": {"type": "string", "minLength": 1},
            "prototype": {"type": "string", "minLength": 1}
          }
        },
        "deep": {
          "type": "object",
          "required": ["logic", "scenes", "structures", "chinese_trap", "study_tip"],
          "properties": {
            "logic": {"type": "string", "minLength": 1},
            "scenes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["title", "body", "example"],
                "properties": {
                  "title": {"type": "string", "minLength": 1},
                  "body": {"type": "string", "minLength": 1},
                  "example": {"type": "string", "minLength": 1}
                }
              }
            },
            "structures": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "chinese_trap": {"type": "string", "minLength": 1},
            "study_tip": {"type": "string", "minLength": 1}
          }
        },
        "network": {
          "type": "object",
          "required": ["system_id", "relations", "next_recommended"],
          "properties": {
            "system_id": {"type": "string", "minLength": 1},
            "relations": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["type", "target", "label", "explanation"],
                "properties": {
                  "type": {"type": "string", "enum": ["system", "growth", "combination", "contrast"]},
                  "target": {"type": "string", "minLength": 1},
                  "label": {"type": "string", "minLength": 1},
                  "explanation": {"type": "string", "minLength": 1}
                }
              }
            },
            "next_recommended": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          }
        },
        "assessment": {
          "type": "object",
          "required": ["transfer", "output"],
          "properties": {
            "transfer": {"type": "object"},
            "output": {"type": "object"}
          }
        }
      },
      "allOf": [
        {
          "if": {"required": ["review_status"], "properties": {"review_status": {"const": "reviewed"}}},
          "then": {"required": ["quick", "deep", "network", "assessment"]}
        }
      ]
    }
  }
}
